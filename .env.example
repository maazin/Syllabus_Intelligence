# Every key the project reads, with local-dev defaults that work as-is.
# `cp .env.example .env` plus `docker compose up` is a complete local setup —
# there should be no undocumented variable (PRD section 24).

# --- Core services -------------------------------------------------------------
# Neon in production, local Postgres in dev (18.1).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5533/syllint
# Celery broker + result backend (18.2).
REDIS_URL=redis://localhost:6479/0

# --- Object storage ------------------------------------------------------------
# MinIO locally, Cloudflare R2 in production — same variable names, because R2
# implements the S3 API and boto3 code does not branch on environment (18.1).
R2_ENDPOINT=http://localhost:9100
R2_ACCESS_KEY_ID=localstack
R2_SECRET_ACCESS_KEY=localstack
R2_BUCKET=syllabi

# --- Extraction ----------------------------------------------------------------
# Leave LLM_API_KEY empty to use ambient credentials (ANTHROPIC_API_KEY or an
# `ant auth login` profile). Two model configs: interactive uploads vs corpus
# seeding, which runs on the batch endpoint at half price (18.1).
LLM_API_KEY=
# `live` calls the model. `replay` serves recorded extractions for the bundled
# fixtures so the full pipeline runs with no key; it refuses to run in
# production. The docker compose worker defaults to replay.
LLM_MODE=replay
LLM_MODEL_SYNC=claude-sonnet-5
LLM_MODEL_STRONG=claude-opus-5
LLM_MODEL_BATCH=claude-sonnet-5

# Self-hosted Docling; handles table structure, which Tesseract cannot (18.1).
OCR_MODE=docling

# --- Observability -------------------------------------------------------------
# MLflow is the prompt registry, the trace store, and the eval tracker (18.1).
# Unset it and extraction still runs; tracing simply becomes a no-op, because an
# observability sidecar must never be able to fail a student's parse.
MLFLOW_TRACKING_URI=http://localhost:5100
SENTRY_DSN=

# --- Corpus pipeline (dbt, Airflow) ---------------------------------------------
# dbt reads these rather than DATABASE_URL, because it takes host and port
# separately. Same database, different spelling.
POSTGRES_HOST=localhost
POSTGRES_PORT=5533
POSTGRES_DB=syllint
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# The Airflow DAG shells out to dbt and reads the coverage mart directly.
DATABASE_URL_PSYCOPG=postgresql://postgres:postgres@localhost:5533/syllint

# --- Email ---------------------------------------------------------------------
# Provider is a config switch, not a code branch (18.4). Locally this is MailHog
# on :1025; production starts on Brevo and moves to SES when the 300/day cap bites.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1125
# Leave both empty for MailHog. Set them for any real relay; a password being
# present is what switches on STARTTLS and login.
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# --- Calendar sync (section 13) ------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Auth ----------------------------------------------------------------------
# Magic-link token signing. Generate a real one for anything but local dev.
JWT_SECRET=local-dev-secret-not-for-production
# Signup is restricted to this domain (15.2).
INSTITUTION_EMAIL_DOMAIN=test.edu

# --- Environment ---------------------------------------------------------------
# local / staging / production — gates things like MailHog vs real email.
ENVIRONMENT=local
