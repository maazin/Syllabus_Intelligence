# Response headers for the static app (Cloudflare Pages).

/*
  # The app is same-origin except for the API and its own config, and it never
  # embeds third-party script. connect-src has to name the API host explicitly
  # because it is a different origin from the page.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.APP_DOMAIN; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # A syllabus timeline has no reason to reach for a camera or a location.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed filenames, so these can be cached indefinitely and never revalidated.
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Not hashed, and it is what points the app at the API. Caching it is how a
# staging build ends up talking to production after a promotion.
/config.json
  Cache-Control: no-store

/index.html
  Cache-Control: no-cache
